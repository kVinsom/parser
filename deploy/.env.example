# Run python3 deploy/configure.py first; replace only the bot token and proxy settings.
# Never commit .env or include it in the source archive.
TELEGRAM_BOT_TOKEN=
# Generate a hexadecimal password to avoid URL escaping problems.
POSTGRES_PASSWORD=
# For migration, import the EXISTING key with export_local_secrets.py on Windows.
WALLET_SESSION_ENCRYPTION_KEY=
WALLET_CHECKOUT_MODE=bot
# bot: Buy pays from the wallet and reports in chat; insufficient funds stop the purchase.
WALLET_CACHE_CAPACITY=4
WALLET_CACHE_IDLE_SECONDS=300
MENU_MODE=menu
WORKER_INTERVAL=4
WORKER_PAGES=3
VPARS_IMAGE_TAG=server
# Browser CPU budget on the 6-vCPU VPS; other services keep the remaining capacity.
BYPARR_CPU_LIMIT=4.0
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
