# Proxy for Byparr's browser. Leave blank for a direct connection.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional address of an already running Byparr service.
BYPARR_URL=http://127.0.0.1:8191

# Return verified catalogs once ready. Set 0 for stock Byparr waiting behavior.
VINTED_FAST_CATALOGS=1

# Fresh compact catalog data, with complete main-document HTML as fallback.
VINTED_DOCUMENT_CATALOG=1
VINTED_COMPACT_CATALOG=1
VINTED_ITEMS_CATALOG=1

# Reuse the browser process; items catalogs reuse anonymous regional contexts.
# Set 0 to compare with Byparr's per-request browser startup.
VINTED_REUSE_BROWSER=1

# Only public immutable JS/CSS; disk data lives in .artifacts/static-cache.
VINTED_STATIC_CACHE=1
VINTED_SKIP_ANALYTICS=1

# Keep capacity for both catalog requests and item details (1..4).
VINTED_GRPC_MAX_INFLIGHT=4
