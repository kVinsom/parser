TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://vpars:vpars_local@127.0.0.1:15432/vpars_bot
REDIS_URL=redis://127.0.0.1:16379/0
UPDATE_MODE=polling
APP_ENV=production
SEARCH_ADAPTER=unavailable
MENU_MODE=menu
SOURCE_CONFIG=config/sources.json
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram
HTTP_HOST=127.0.0.1
HTTP_PORT=8085
# bot: Telegram Buy pays wallet-only and reports the result in chat. No checkout HTTPS needed.
# manual/balance_first use an HTTPS checkout window. All auto-payment needs a verified account.
# Bind only to loopback; expose this port through HTTPS, never an unauthenticated browser port.
WALLET_HANDOFF_URL=
WALLET_HANDOFF_PORT=8086
WALLET_CHECKOUT_MODE=bot
WALLET_CACHE_CAPACITY=4
WALLET_CACHE_IDLE_SECONDS=300
INBOX_CONCURRENCY=8
HANDLER_TIMEOUT=20
TELEGRAM_REQUEST_TIMEOUT=7
TELEGRAM_CONNECTION_LIMIT=40
TELEGRAM_MESSAGES_PER_SECOND=25
TELEGRAM_CHAT_INTERVAL=1
WEBHOOK_MAX_CONNECTIONS=40
